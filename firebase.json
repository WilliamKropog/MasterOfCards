{
  "auth": {
    "authorizedDomains": [
      "localhost",
      "master-of-cards.web.app",
      "master-of-cards.firebaseapp.com"
    ],
    "providers": {
      "emailPassword": true,
      "anonymous": false
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist/masterofcards/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
